{
    "name": "short-edition/comment-bundle",
    "type": "symfony-bundle",
    "description": "This Bundle provides threaded comment functionality for Symfony applications",
    "keywords": ["comment", "threads", "forum"],
    "homepage": "http://friendsofsymfony.github.com",
    "license": "MIT",
    "authors": [
        {
            "name": "Tim Nagel",
            "email": "tim@nagel.com.au"
        },
        {
            "name": "Alexander Mols",
            "email": "iam.asm89@gmail.com"
        },
        {
            "name": "FriendsOfSymfony Community",
            "homepage": "https://github.com/friendsofsymfony/FOSCommentBundle/contributors"
        }
    ],
    "support": {
        "irc": "irc://irc.freenode.org/symfony-dev",
        "issues": "https://github.com/FriendsOfSymfony/FOSCommentBundle/issues"
    },
    "require": {
        "php": "^8.0",
        "friendsofsymfony/rest-bundle": "^3.3",
        "jms/serializer-bundle": "^4.0|^5.0",
        "symfony/framework-bundle": "^6.0|^7.0",
        "symfony/asset": "^6.0|^7.0",
        "symfony/dependency-injection": "^6.0|^7.0",
        "symfony/routing": "^6.0|^7.0",
        "symfony/security-bundle": "^6.0|^7.0",
        "symfony/yaml": "^6.0|^7.0",
        "symfony/form": "^6.0|^7.0",
        "symfony/twig-bundle": "^6.0|^7.0",
        "symfony/twig-bridge": "^6.0|^7.0",
        "twig/twig": "^2.0|^3.0",
        "phpoption/phpoption": "^1.1",
        "doctrine/annotations": "^1.8|^2.0",
        "symfony/flex": "^1.6|^2.0"
    },
    "suggest": {
        "ornicar/akismet-bundle": "Integrate Akismet for spam detection.",
        "symfony/acl-bundle": "Integrates the ACL Security component.",
        "symfony/assetic-bundle": "Integrates Assetic into Symfony."
    },
    "require-dev": {
        "symfony/browser-kit": "^6.0|^7.0",
        "symfony/dom-crawler": "^6.0|^7.0",
        "symfony/css-selector":"^6.0|^7.0",
        "doctrine/orm": "^2.3",
        "doctrine/doctrine-bundle": "^1.12|^2.0",
        "ornicar/akismet-bundle": "dev-master",
        "symfony/expression-language": "^6.0|^7.0",
        "symfony/phpunit-bridge": "^6.0|^7.0",
        "phpunit/phpunit": "^6.5",
        "friendsofphp/php-cs-fixer": "^2.16"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "3.0.x-dev"
        },
        "symfony": {
            "require": "^5.0"
        }
    },
    "autoload": {
        "psr-4": { "FOS\\CommentBundle\\": "" },
        "exclude-from-classmap": [ "/Tests/" ]
    },
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/short-edition/FOSUserBundle.git"
        }
    ]
}
